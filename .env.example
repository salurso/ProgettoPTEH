# ─────────────────────────────────────────────
# Configurazione LLM Pentest Framework
# Copia questo file in .env e inserisci le tue chiavi:  cp .env.example .env
# ─────────────────────────────────────────────

# Provider LLM: "groq" (consigliato, gratuito) oppure "mock" per sviluppo offline
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_la_tua_chiave_qui

# Modello da usare (default del codice se omesso)
LLM_MODEL=qwen/qwen3.8-27b

# ─────────────────────────────────────────────
# Sicurezza / esecuzione
# ─────────────────────────────────────────────
# Blocca IP pubblici negli args durante l'esecuzione
SANDBOX_MODE=true
# Reti/target consentiti (CIDR separati da virgola)
TARGET_WHITELIST=192.168.56.0/24

# Autorizzazione automatica SOLO per run non interattivi (pipeline/CI).
# Lascia "false" per l'uso manuale: verrà chiesta conferma esplicita del target.
PENTEST_AUTO_AUTH=false

# Target di default (sovrascrivibile da argomento CLI: python recon.py <target>)
PENTEST_TARGET=192.168.56.4

# ─────────────────────────────────────────────
# NVD (opzionale)
# ─────────────────────────────────────────────
# Se vuota, il framework usa il dataset curato offline (verificato per versione)
NVD_API_KEY=
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_CACHE_DB=output/nvd_cache.db
NVD_CACHE_TTL_HOURS=24

# ─────────────────────────────────────────────
# Metasploit RPC
# ─────────────────────────────────────────────
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_PASSWORD=msfrpc
# Moduli MSF extra approvati (oltre a quelli di default), separati da virgola
MSF_EXTRA_APPROVED_MODULES=

# Tetto massimo (NON consumo fisso) di token di output per la generazione del
# report e per il secondo giro mirato dei consigli. Abbassali se il tuo tier
# LLM gratuito ha limiti TPM stringenti (il report resta completo perché
# l'output è stato reso conciso).
REPORT_MAX_TOKENS=1500
ADVICE_MAX_TOKENS=800
